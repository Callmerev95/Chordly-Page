{
  "name": "chordly-page",
  "private": true,
  "version": "0.1.0",
  "description": "Official landing page for Chordly, an independent YouTube Music player with synced lyrics and Bit-Perfect audio.",
  "type": "module",
  "license": "GPL-3.0-only",
  "author": "Callmerev95",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Callmerev95/Chordly-Page.git"
  },
  "bugs": {
    "url": "https://github.com/Callmerev95/Chordly/issues"
  },
  "keywords": ["chordly", "youtube-music", "music-player", "synced-lyrics", "android", "wear-os", "react", "vite", "tailwindcss"],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && tsx scripts/prerender.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/utils/audioEngine.test.ts src/utils/featureCatalog.test.ts src/utils/releases.test.ts src/utils/testimonialsFeed.test.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lrc-kit": "^1.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}